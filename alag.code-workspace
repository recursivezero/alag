{
  "settings": {
    "workbench.colorCustomizations": {
      "activityBar.activeBackground": "#777152",
      "activityBar.background": "#777152",
      "activityBar.foreground": "#e7e7e7",
      "activityBar.inactiveForeground": "#e7e7e799",
      "activityBarBadge.background": "#8eb1ab",
      "activityBarBadge.foreground": "#15202b",
      "commandCenter.border": "#e7e7e799",
      "sash.hoverBorder": "#777152",
      "statusBar.background": "#59543d",
      "statusBar.foreground": "#e7e7e7",
      "statusBarItem.hoverBackground": "#777152",
      "statusBarItem.remoteBackground": "#59543d",
      "statusBarItem.remoteForeground": "#e7e7e7",
      "titleBar.activeBackground": "#59543d",
      "titleBar.activeForeground": "#e7e7e7",
      "titleBar.inactiveBackground": "#59543d99",
      "titleBar.inactiveForeground": "#e7e7e799",
      "sideBar.border": "#777152",
      "tab.activeBorder": "#777152"
    },
    "peacock.color": "#59543d",
    "eslint.validate": [
    "javascript",
    "javascriptreact",
    "astro",
    "typescript", 
    "typescriptreact"
  ],
  "folder-color.pathColors": [],
  "files.exclude": {
    "**/node_modules": true,
    "**/.astro": true
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.ts": "${capture}.js",
    "*.tsx": "${capture}.ts",
    ".env":".env*",
    ".gitignore": ".npm*, eslint*,.editorconfig,.babel*,.prettier*, .git*, .markdown*, .nojekyll",
    "package.json": "package-lock.json, yarn.lock",
    "tsconfig.json": "tsconfig.*.json",
    "README.md": "*.md, LICENSE"
  },
  },
  "folders": [
    {
      "path": "."
    }
  ]
}